+    """
+    comment = (
+        comment.replace(REVIEW_MARKER, "")
+        .replace(REVIEW_PREAMBLE.strip(), "")
+        .strip()
+    )
+    return f"{REVIEW_MARKER}\n\n{REVIEW_PREAMBLE}\n\n{comment}"
