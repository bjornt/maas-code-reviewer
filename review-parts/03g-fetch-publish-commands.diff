+    def test_records_none_prefix_for_github_diff_shapes(self, tmp_path: Path) -> None:
+        diff = (
+            "diff --git a/new.py b/new.py\n"
+            "--- /dev/null\n"
+            "+++ b/new.py\n"
+            "@@ -0,0 +1,1 @@\n"
+            "+new\n"
+            "diff --git a/changed.py b/changed.py\n"
+            "--- a/changed.py\n"
+            "+++ b/changed.py\n"
+            "@@ -1 +1 @@\n"
+            "-old\n"
+            "+changed\n"
+            "diff --git a/gone.py b/gone.py\n"
