+            "inline_comments": {},
+        }
+
+        result = render_merge_proposal_comment(review)
+
+        assert result == (
+            f"{REVIEW_MARKER}\n\n{REVIEW_PREAMBLE}\n\n{EMPTY_DIFF_GENERAL_COMMENT}"
