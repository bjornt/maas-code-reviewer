+        run: |
+          PR_BODY="$PR_BODY_ENV"
+
+          # Same keywords as the lp-bug-update workflow.
+          CLOSING_KEYWORDS='close|closes|closed|fix|fixes|fixed|resolve|resolves|resolved'
+          if grep -qiP "\b(?:$CLOSING_KEYWORDS)\b.*lp:" <<< "$PR_BODY"; then
