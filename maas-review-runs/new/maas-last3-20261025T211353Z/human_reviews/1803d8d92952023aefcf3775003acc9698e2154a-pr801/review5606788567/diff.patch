+class InjectTLSWithoutClientCert(BaseHTTPMiddleware):
+    async def dispatch(
+        self,
+        request: Request,
+        call_next: Callable[[Request], Awaitable[Response]],
+    ) -> Response:
+        request.scope.setdefault("extensions", {})
+        request.scope["extensions"]["tls"] = {}
+        return await call_next(request)
+
